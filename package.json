{
  "name": "commission-board",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "cd backend && .venv/Scripts/python.exe -m uvicorn app.main:app --reload --port 8000",
    "dev:api:posix": "cd backend && .venv/bin/python -m uvicorn app.main:app --reload --port 8000",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:api": "cd backend && .venv/Scripts/python.exe -m pytest",
    "seed": "cd backend && .venv/Scripts/python.exe -m app.seed"
  },
  "dependencies": {
    "lucide-react": "^1.39.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.5",
    "oxlint": "^1.79.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "vite": "^8.2.2"
  }
}
